# Starts the remote HTTP checks at the start of every minute (design section
# 6.2.1); each check runs only when its own interval is due. No Persistent=:
# a missed minute is not worth running late. systemd never starts the
# service again while it is still running.
[Unit]
Description=Run the Maguari remote HTTP checks every minute
Documentation=https://github.com/alvesgu/maguari

[Timer]
OnCalendar=*-*-* *:*:00 UTC
AccuracySec=1s

[Install]
WantedBy=timers.target
