#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Maguari\Server\Access\AccessApi;
use Maguari\Server\Access\Exception\InvalidSeedConfig;
use Maguari\Server\Access\Exception\SetupNotAllowed;
use Maguari\Server\Access\SeedConfigReader;
use Maguari\Server\Kernel\Database\Database;
use Maguari\Server\Kernel\Database\DatabaseUnavailable;
use Maguari\Server\Kernel\Database\Migrator;
use Maguari\Server\Kernel\Secrets\SecretKeyFile;
use Maguari\Server\Kernel\SystemClock;
use Maguari\Shared\ServerUrl;

/**
 * @param string[] $args
 */
function maguariServerMain(array $args): int
{
    $command = $args[1] ?? null;

    if ($command === 'check-seed-config') {
        return checkSeedConfigCommand(array_slice($args, 2));
    }

    if ($command === 'migrate') {
        return refuseRoot(array_slice($args, 1)) ?? migrateCommand();
    }

    if ($command === 'issue-setup-token') {
        return refuseRoot(array_slice($args, 1)) ?? issueSetupTokenCommand(array_slice($args, 2));
    }

    if ($command === 'set-base-url') {
        return refuseRoot(array_slice($args, 1)) ?? setBaseUrlCommand(array_slice($args, 2));
    }

    if ($command === 'create-secret-key') {
        return refuseRoot(array_slice($args, 1), 'the key file would end up owned by root') ?? createSecretKeyCommand();
    }

    fwrite(STDERR, "Usage:\n"
        . "  maguari-server check-seed-config [--path=/etc/maguari/seed.ini]\n"
        . "  maguari-server migrate\n"
        . "  maguari-server issue-setup-token --base-url=https://maguari.example.com\n"
        . "  maguari-server set-base-url --base-url=https://maguari.example.com\n"
        . "  maguari-server create-secret-key\n");

    return 1;
}

/**
 * Commands that create or write the database or the secret key file must not
 * run as root, or the file ends up owned by root and the web app (running as
 * maguari-server) cannot use it. Returns the exit code when refusing, null
 * otherwise.
 *
 * @param string[] $commandArgs the subcommand and its arguments
 */
function refuseRoot(array $commandArgs, string $consequence = 'the database would end up owned by root'): ?int
{
    if (posix_geteuid() !== 0) {
        return null;
    }

    $command = implode(' ', array_map('escapeshellarg', $commandArgs));
    fwrite(STDERR, "Do not run maguari-server {$commandArgs[0]} as root: {$consequence}.\n"
        . "Run it as the app's user instead:\n"
        . "  sudo -u maguari-server maguari-server {$command}\n");

    return 1;
}

/**
 * Creates the database if needed and applies pending migrations.
 */
function migrateDatabase(Database $database): void
{
    $database->create();

    foreach ((new Migrator($database))->migrate() as $migration) {
        echo "Applied migration {$migration}\n";
    }
}

function migrateCommand(): int
{
    $database = Database::fromEnvironment();
    migrateDatabase($database);
    echo "Database {$database->path()} is up to date.\n";

    return 0;
}

/**
 * Reads --base-url=<url>. The setup URL carries the one-time token and enroll
 * commands send secrets to this address, so it must use HTTPS. Plain HTTP is
 * accepted only for localhost, for local development (ServerUrl).
 *
 * @param string[] $args
 * @return string|int the normalized URL, or the exit code after printing why not
 */
function baseUrlArgument(array $args, string $command): string|int
{
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--base-url=')) {
            $baseUrl = ServerUrl::normalize(substr($arg, strlen('--base-url=')));

            if ($baseUrl === null) {
                fwrite(STDERR, "--base-url must be an https:// URL with no path, for example https://maguari.example.com. "
                    . "http:// is accepted only for localhost.\n");

                return 1;
            }

            return $baseUrl;
        }
    }

    fwrite(STDERR, "Usage: maguari-server {$command} --base-url=https://maguari.example.com\n");

    return 1;
}

/**
 * @param string[] $args
 */
function issueSetupTokenCommand(array $args): int
{
    $baseUrl = baseUrlArgument($args, 'issue-setup-token');

    if (is_int($baseUrl)) {
        return $baseUrl;
    }

    $database = Database::fromEnvironment();
    migrateDatabase($database);
    $accessApi = new AccessApi($database, new SystemClock());

    try {
        $issued = $accessApi->issueSetupToken();
    } catch (SetupNotAllowed $exception) {
        fwrite(STDERR, $exception->getMessage() . " No setup token was issued.\n");

        return 1;
    }

    // The domain given at setup is the server's configured address, used in
    // enroll commands (never the request's Host header).
    $accessApi->setBaseUrl($baseUrl);

    echo "Open this URL to create the administrator. It works once, until "
        . gmdate('Y-m-d H:i', $issued->expiresAt) . " UTC. Any earlier setup link no longer works.\n\n";
    echo $baseUrl . '/auth/setup?token=' . $issued->token . "\n";

    return 0;
}

/**
 * Sets the server's address after setup: on installs set up before it was
 * recorded, when the domain changes, and in development.
 *
 * @param string[] $args
 */
function setBaseUrlCommand(array $args): int
{
    $baseUrl = baseUrlArgument($args, 'set-base-url');

    if (is_int($baseUrl)) {
        return $baseUrl;
    }

    $database = Database::fromEnvironment();
    migrateDatabase($database);
    (new AccessApi($database, new SystemClock()))->setBaseUrl($baseUrl);
    echo "The server's address is now {$baseUrl}. Enroll commands use it.\n";

    return 0;
}

/**
 * Creates the key that encrypts secrets at rest (design section 9.3). Never
 * overwrites an existing key: every stored client secret depends on it.
 */
function createSecretKeyCommand(): int
{
    $keyFile = SecretKeyFile::fromEnvironment();

    if (!$keyFile->create()) {
        echo "The secret key file {$keyFile->path()} already exists. It was not changed: "
            . "a new key would make every stored client secret unreadable.\n";

        return 0;
    }

    echo "Created the secret key file {$keyFile->path()} (mode 0600). Back it up, but not together with the database: "
        . "a backup holding both would expose the secrets the key protects. Without the key, every instance must enroll again.\n";

    return 0;
}

/**
 * @param string[] $args
 */
function checkSeedConfigCommand(array $args): int
{
    $path = '/etc/maguari/seed.ini';

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--path=')) {
            $path = substr($arg, strlen('--path='));
        }
    }

    $accessApi = new AccessApi(Database::fromEnvironment(), new SystemClock(), new SeedConfigReader($path));

    try {
        $seedConfig = $accessApi->readSeedConfig();
    } catch (InvalidSeedConfig $exception) {
        fwrite(STDERR, $exception->getMessage() . "\n");

        return 1;
    }

    if ($seedConfig === null) {
        echo "No seed config file found at {$path}. Nothing to seed.\n";

        return 0;
    }

    echo "Seed config file: {$path}\n";
    echo "Administrator: {$seedConfig->administratorName} <{$seedConfig->administratorEmail}>\n";
    echo "Allowlist: " . implode(', ', $seedConfig->allowlist) . "\n";
    echo "Nothing applied: applying seeded values is not implemented yet.\n";

    return 0;
}

/**
 * Runs the command and turns any exception into one line on stderr and exit
 * code 1, so no command ends with a PHP stack trace. Printing the message is
 * safe because exception messages never contain secrets.
 *
 * @param string[] $args
 */
function runMaguariServer(array $args): int
{
    $databaseHint = 'Check that this user can create and write it, or set MAGUARI_DATABASE to another path '
        . '(development and tests only).';

    try {
        return maguariServerMain($args);
    } catch (DatabaseUnavailable $exception) {
        $message = $exception->getMessage() . ' ' . $databaseHint;
    } catch (PDOException $exception) {
        // A database that opened but failed later, for example a read-only file.
        $message = sprintf('Database error at %s: %s. %s', Database::fromEnvironment()->path(), $exception->getMessage(), $databaseHint);
    } catch (Throwable $exception) {
        $message = sprintf('maguari-server failed: %s', $exception->getMessage());
    }

    fwrite(STDERR, str_replace(["\r", "\n"], ' ', $message) . "\n");

    return 1;
}

exit(runMaguariServer($argv));
