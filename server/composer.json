{
    "name": "maguari/server",
    "description": "Maguari server: dashboard, alerts and remediation for GCE instances",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Maguari\\Server\\": "src/",
            "Maguari\\Shared\\": "../shared/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maguari\\Server\\Tests\\": "tests/",
            "Maguari\\Shared\\Tests\\": "../shared/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
